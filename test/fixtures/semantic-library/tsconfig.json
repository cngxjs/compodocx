{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "strict": true,
        "baseUrl": ".",
        "paths": {
            "@sem/core": ["projects/core/src/public-api.ts"],
            "@sem/core/tokens": ["projects/core/tokens/src/public-api.ts"],
            "@sem/ui": ["projects/ui/src/public-api.ts"],
            "@sem/testing": ["projects/testing/public-api.ts"],
            "@sem/env": ["projects/env/environment.ts"],
            "@sem/*": ["projects/*"]
        }
    },
    "include": ["projects/**/*.ts"]
}
