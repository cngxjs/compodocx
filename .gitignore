# Logs
logs
*.log
npm-debug.log*
.DS_Store

# Dependency directories
node_modules

#ide folders
.idea/
.vscode/

# Internal design docs (local only)
.internal/

# Optional npm cache directory
.npm

# Test js files
test/dist/
documentation
doc

# Coverage directory used by tools like istanbul
coverage
.nyc_output
coverage.*
!src/app/services/coverage.ts
!test/src/app/services/coverage.spec.ts

.dockerignore

# Build-output
dist/

# Compiled TypeScript files in src/ (keep legitimate JS assets)
src/**/*.js
!src/resources/**/*.js

# Client-bundle build artifacts. Regenerated by `npm run build:client`
# (tsdown). Always rebuilt before pack/test via `prebuild`/`pretest`.
src/resources/js/compodocx.js
src/resources/js/chunks/

# npm pack output (e.g. `npm pack`, release dry-runs)
*.tgz

# Miscellaneous
tmp/
.tmp/
.tmp*
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

.angular/

# Playwright MCP snapshots
.playwright-mcp/
/test/fixtures/cngx-library/
/test/fixtures/rsg-module-library/
/test/fixtures/playground-demo/*
