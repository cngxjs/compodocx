{
    "name": "@cngxjs/compodocx",
    "version": "0.8.0",
    "description": "Static documentation generator for modern Angular projects — signals, inject(), standalone components, theming tab, JS-based template overrides, Pagefind search.",
    "main": "dist/index.js",
    "bin": {
        "compodocx": "./bin/index-cli.js",
        "compodoc": "./bin/index-cli.js"
    },
    "scripts": {
        "start": "npm run test:watch",
        "*********BUILD********": "*******************",
        "prebuild": "rimraf dist",
        "build": "tsdown && node scripts/postbuild-shebang.mjs && npm run build-schematics && npm run build:client && npm run build:css && npm run build:themes",
        "build:client": "tsdown --config tsdown.client.config.ts",
        "build:css": "tailwindcss -i src/styles/compodocx.css -o src/resources/styles/compodocx.css --minify",
        "build:themes": "node -e \"const fs=require('fs'),p=require('path');fs.readdirSync('src/themes').filter(f=>f.endsWith('.css')&&f!=='theme-template.css').forEach(f=>fs.copyFileSync(p.join('src/themes',f),p.join('src/resources/styles',f)))\"",
        "dev": "node scripts/dev-watch.mjs",
        "dev:standalone": "node scripts/dev-watch.mjs --fixture=kitchen-sink-standalone --port=8081",
        "dev:module": "node scripts/dev-watch.mjs --fixture=kitchen-sink-module --port=8080",
        "build-schematics": "tsc --project schematics/tsconfig.json && cp schematics/collection.json dist && cp schematics/ng-add/schema.json dist/schematics/ng-add/schema.json",
        "*********UTILS********": "*******************",
        "changelog": "auto-changelog -o CH.md  --template tools/changelog-template.hbs -u",
        "download-api-list": "node tools/download-api-list.js",
        "bench": "node scripts/bench.mjs",
        "madge": "./node_modules/.bin/madge --warning -i dist/madge.png src/index-cli.ts",
        "*********TEST********": "*******************",
        "pretest": "npm run build",
        "test": "npm run test:unit && npm run test:cli",
        "test:unit": "vitest run test/src/utils test/src/app test/src/templates test/src/client test/src/migrate test/src/diff test/src/llm-md test/src/playground-validate test/src/schematics test/src/lib",
        "test:migrate": "vitest run test/src/migrate",
        "test:cli": "vitest run test/src/cli",
        "test:all": "vitest run",
        "test:watch": "vitest watch",
        "*********TEST E2E********": "*******************",
        "test:simple-doc": "node ./bin/index-cli.js --no-multiVersion -p ./test/fixtures/sample-files/tsconfig.simple.json -d doc -s --port 4000 --toggleMenuItems modules,components,directives,classes,injectables,interceptors,guards,pipes,interfaces,miscellaneous,additionalPages",
        "test:todomvc-doc": "node ./bin/index-cli.js --no-multiVersion -p ./test/fixtures/todomvc-ng2/src/tsconfig.json -d /tmp/compodoc-todomvc -s --port 4001 --disableSearch",
        "test:standalone-doc": "node ./bin/index-cli.js --no-multiVersion -p ./test/fixtures/standalone-app/src/tsconfig.json --includes ./test/fixtures/standalone-app/additional-doc -d /tmp/compodoc-standalone -s --port 4002 --disableSearch --toggleMenuItems modules,components,directives,classes,injectables,interceptors,guards,pipes,interfaces,miscellaneous,additionalPages",
        "test:standalone-feature-doc": "node ./bin/index-cli.js -c ./test/fixtures/standalone-app/.compodocxrc.feature.json --no-multiVersion -p ./test/fixtures/standalone-app/src/tsconfig.json -d /tmp/compodoc-standalone-feature -s --port 4004 --disableSearch --toggleMenuItems features,modules,miscellaneous,additionalPages",
        "test:multi-version-doc": "node ./scripts/build-multi-version-fixture.mjs",
        "test-e2e-playwright": "npx playwright test",
        "*********QUALITY********": "*******************",
        "lint": "biome check",
        "lint:fix": "biome check --fix",
        "format:check": "biome format",
        "format:write": "biome format --write"
    },
    "watch": {
        "build": {
            "patterns": [
                "src/**/*.ts"
            ],
            "extensions": "js,ts",
            "quiet": true
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cngxjs/compodocx.git"
    },
    "keywords": [
        "angular",
        "angular-documentation",
        "documentation",
        "documentation-generator",
        "static-site-generator",
        "typescript",
        "components",
        "standalone",
        "standalone-components",
        "signals",
        "inject",
        "api-docs",
        "jsdoc",
        "theming",
        "css-custom-properties",
        "pagefind",
        "shiki",
        "compodoc"
    ],
    "author": "Christian Weiss",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/cngxjs/compodocx/issues"
    },
    "engines": {
        "node": ">=22"
    },
    "files": [
        "dist/",
        "bin/",
        "src/resources/",
        "src/data/",
        "src/banner",
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
        "MIGRATION.md"
    ],
    "homepage": "https://compodocx.dev",
    "dependencies": {
        "@compodoc/ngd-transformer": "^2.1.3",
        "@kitajs/html": "^4.2.13",
        "@polka/send-type": "^0.5.2",
        "@stackblitz/sdk": "^1.11.0",
        "body-parser": "^2.2.2",
        "cheerio": "^1.2.0",
        "chokidar": "^5.0.0",
        "commander": "^14.0.2",
        "cosmiconfig": "^9.0.0",
        "d3": "^7.9.0",
        "decache": "^4.6.2",
        "fast-glob": "^3.3.3",
        "fs-extra": "^11.3.3",
        "glob": "^13.0.0",
        "handlebars": "^4.7.8",
        "html-entities": "^2.6.0",
        "i18next": "25.7.4",
        "json5": "^2.2.3",
        "marked": "7.0.3",
        "minimist": "^1.2.8",
        "neotraverse": "^0.6.18",
        "os-name": "4.0.1",
        "picocolors": "^1.1.1",
        "polka": "^0.5.2",
        "semver": "^7.7.3",
        "shiki": "^4.0.2",
        "sirv": "^3.0.2",
        "ts-morph": "^27.0.2",
        "uuid": "11.1.0"
    },
    "devDependencies": {
        "@angular-devkit/schematics": "^21.2.9",
        "@biomejs/biome": "^2.4.14",
        "@kitajs/ts-html-plugin": "^4.1.4",
        "@playwright/test": "^1.59.1",
        "@tailwindcss/cli": "^4.2.2",
        "@types/archiver": "^7.0.0",
        "@types/d3": "^7.4.3",
        "@types/fs-extra": "11.0.4",
        "@types/marked": "6.0.0",
        "@types/node": "^25.6.0",
        "@types/polka": "^0.5.8",
        "@types/semver": "7.7.1",
        "@types/traverse": "0.6.37",
        "archiver": "^7.0.1",
        "auto-changelog": "2.5.0",
        "husky": "9.1.7",
        "jsdom": "^28.1.0",
        "madge": "8.0.0",
        "npm-watch": "0.13.0",
        "pagefind": "^1.4.0",
        "pretty-quick": "4.2.2",
        "release-it": "^19.2.4",
        "rimraf": "6.1.2",
        "supertest": "7.2.2",
        "tailwindcss": "^4.2.2",
        "tsdown": "0.21.10",
        "tslib": "2.8.1",
        "vitest": "^4.1.2"
    },
    "husky": {
        "hooks": {
            "pre-commit": "pretty-quick --staged --pattern \"**/*.ts\""
        }
    },
    "schematics": "./dist/collection.json",
    "ng-add": {
        "save": "devDependencies"
    }
}
